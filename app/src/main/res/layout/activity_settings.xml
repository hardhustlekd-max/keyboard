<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="#F9FAFB">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="አማርኛ - Amharic Keyboard"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#1F2937"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Windows 10 Phonetic Phonetic Engine"
        android:textSize="14sp"
        android:textColor="#6B7280"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Checking status..."
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#3B82F6"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/btnEnableKeyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. Enable Keyboard in System Settings"
        android:textSize="16sp"
        android:padding="14dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#2563EB"
        android:textColor="#FFFFFF"/>

    <Button
        android:id="@+id/btnSelectKeyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2. Switch Input Method to Amharic"
        android:textSize="16sp"
        android:padding="14dp"
        android:backgroundTint="#059669"
        android:textColor="#FFFFFF"/>

</LinearLayout>
